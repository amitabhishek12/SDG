# API key for an OpenAI-compatible provider. When unset, ERP schema inference
# and the contextual data fallback are disabled; Faker-based custom generation
# still works.
OPENAI_API_KEY=

# To use OpenRouter with the OpenAI gpt-4o-mini model, set your OpenRouter key
# above and uncomment both lines below:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
MAX_RECORDS=100
PREVIEW_ROWS=10